# App
VITE_APP_URL=https://sra.ai2paper.com
VITE_APP_NAME="SRA Explorer NG"
VITE_APP_DESCRIPTION="Search NCBI SRA and batch-download FASTQ, normalized SRA, FAST5, POD5, and Original submitted files."
VITE_APP_LOGO=/logo.svg
VITE_DEFAULT_LOCALE=en

# Server-only (optional)
# NCBI_API_KEY=   # raises NCBI E-utilities limit from 3 to 10 req/s
# SRA_API_TOKENS= # comma-separated bearer tokens exempt from the anonymous rate limit
# KV_REST_API_URL=  # Upstash Redis REST URL for a shared rate limit (Vercel KV/Upstash integration)
# KV_REST_API_TOKEN=
